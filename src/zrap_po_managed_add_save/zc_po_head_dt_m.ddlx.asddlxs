@Metadata.layer: #CORE
@UI:{ headerInfo: {
    typeName: 'Purchase Order',
    typeNamePlural: 'Purchase Orders',
    title: {
        type: #STANDARD,
        value: 'PoNum'
    }
} }
@Search.searchable: true
annotate entity ZC_PO_HEAD_DT_M with
{
  @UI.facet: [{
  id: 'POHd',
  purpose: #STANDARD,
  position: 10,
  //    type:#IDENTIFICATION_REFERENCE,
  type:#COLLECTION,
  label: 'Purchase Order Header'
  },
  {
  id: 'BasicInfo',
  purpose:#STANDARD,
  parentId: 'POHd',
  position:10,
  targetQualifier: 'BasicGroup',
  type:#FIELDGROUP_REFERENCE,
  label:'Basic Details'
  },

  {
  id: 'OrgInfo',
  purpose:#STANDARD,
  parentId: 'POHd',
  position:20,
  targetQualifier: 'OrgGroup',
  type:#FIELDGROUP_REFERENCE,
  label:'Organization Details'

  },

  {
  id: 'MorDet',
  purpose:#STANDARD,
  parentId: 'POHd',
  position:30,
  targetQualifier: 'MoreDet',
  type:#FIELDGROUP_REFERENCE,
  label:'More Details'
  },
  {
  id: 'POItems',
  purpose: #STANDARD,
  type:#LINEITEM_REFERENCE,
  position: 20,
  targetElement: '_Items',
  label: 'Purchase Order Items'
  }
  ]

  @UI.lineItem: [{ position: 10,label: 'Purchase Order'}]
  //  @UI.identification: [{ position: 10,label: 'Purchase Order'  }]
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.quickInfo: 'Purchase Orders'
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.7
  @UI.fieldGroup: [{ position: 10, label: 'Purchase Order',qualifier: 'BasicGroup' }]
  PoNum;

  @UI.lineItem: [{ position: 20,label: 'Order Type', importance: #HIGH }]
  //@UI.identification: [{ position: 30,label: 'Order Type'  }]
  @UI.fieldGroup: [{ position: 20, label: 'Order Type',qualifier: 'BasicGroup' }]
  Type;

  @UI.lineItem: [{ position: 30,label: 'Company Code', importance: #HIGH }]
  //@UI.identification: [{ position: 40,label: 'Company Code' }]
  @UI.fieldGroup: [{ position: 30, label: 'Company Code',qualifier: 'OrgGroup' }]
  CompCode;

  @UI.lineItem: [{ position: 40,label: 'Organization', importance: #HIGH }]
  //@UI.identification: [{ position: 50,label: 'Organization'  }]
  @UI.fieldGroup: [{ position: 40, label: 'Organization',qualifier: 'OrgGroup' }]
  Org;

  @UI.lineItem: [{ position: 50, label: 'Vendor' }]
  // @UI.identification: [{ position: 60, label: 'Vendor'  }]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [{ position: 50, label: 'Vendor',qualifier: 'OrgGroup' }]
  Vendor;

  @UI.lineItem: [{ position: 60,label: 'Status'}]
  // @UI.identification: [{ position: 80,label: 'Purchase Status' }]
  @UI.fieldGroup: [{ position: 60, label: 'Purchase Status',qualifier: 'MoreDet' }]
  Status;

  // @UI.identification: [{ position: 70,label: 'Document Category' }]
  @UI.fieldGroup: [{ position: 70, label: 'Creation Date',qualifier: 'MoreDet' }]
  DocCat;

  @UI.lineItem: [{ position: 80, label: 'Approved' }]
  // @UI.identification: [{ position: 80,label: 'Approved' }]
  @UI.fieldGroup: [{ position: 90, label: 'Approval',qualifier: 'MoreDet' }]
  Approved;

  @UI.fieldGroup: [{ position: 100, label: 'Created By',qualifier: 'MoreDet' }]
  CreatedBy;

  @UI.fieldGroup: [{ position: 110, label: 'Created At',qualifier: 'MoreDet' }]
  CreatedAt;

  @UI.fieldGroup: [{ position: 120, label: 'LastChanged By',qualifier: 'MoreDet' }]
  LastChangedBy;

  @UI.fieldGroup: [{ position: 130, label: 'Last Changed At',qualifier: 'MoreDet' }]
  LastChangedAt;

}
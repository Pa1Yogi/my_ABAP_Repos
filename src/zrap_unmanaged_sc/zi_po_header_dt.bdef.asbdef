unmanaged implementation in class zbp_i_po_header_dt unique;
strict ( 2 );

define behavior for ZI_PO_HEADER_DT //alias <alias_name>
//implementation in class zbp_i_po_header_dt unique
//late numbering
//draft table zdrt_po_header
lock master
//total etag ChangedDateTime
authorization master ( instance )
etag master LastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  //field ( readonly ) PoNum;
  // Fields that are mandatory for create but should be read-only
  field ( mandatory : create, readonly : update ) Ponum;
  field ( mandatory ) DocCat, CompCode, Org, Status, Vendor;
  action ( features : instance ) Change_status result [1] $self;
  action ( features : instance ) Selected result [1] $self;
  /* draft action Activate;
   draft action Discard;
   draft action Edit;
   draft action Resume;
   draft determine action Prepare; */
  association _PO_items { create ( features : instance ); }
  mapping for ztb_pohead corresponding
    {
      PoNum              = po_num;
      DocCat             = doc_cat;
      Type               = type;
      CompCode           = comp_code;
      Org                = org;
      Status             = status;
      Vendor             = vendor;
      CreatedBy          = created_by;
      CreatedDateTime    = created_date_time;
      ChangedDateTime    = changed_date_time;
      LocalLastChangedBy = local_last_changed_by;
    }

}

define behavior for ZI_PO_ITEMS_DT //alias <alias_name>
//implementation in class zbp_i_po_items_dt unique
//draft table zdrt_po_items
//late numbering
lock dependent by _po_hd
authorization dependent by _po_hd
etag dependent by _po_hd
{
  update;
  delete;
  //  field ( readonly ) PoNum, PoItem;
  //  field ( readonly ) PoNum, PoItem;
  field ( readonly ) Ponum;

  // Fields that are mandatory for create but should be read-only
  field ( mandatory : create, readonly : update ) Poitem;
  field ( mandatory ) ItemText, Material, Uom, Plant, StorLoc, Qty, ProductPrice, PriceUnit;
  mapping for ztb_poitems corresponding
    {
      PoNum        = po_num;
      PoItem       = po_item;
      ItemText     = item_text;
      Material     = Material;
      Uom          = Uom;
      Plant        = Plant;
      StorLoc      = stor_loc;
      Qty          = Qty;
      ProductPrice = product_price;
      PriceUnit    = price_unit;
      //      LocalLastChangedAt = local_last_changed_at;
      //      LocalLastChangedBy = local_last_changed_by;
    }

  association _po_hd;
}
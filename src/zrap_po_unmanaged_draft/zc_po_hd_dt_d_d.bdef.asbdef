projection;
strict ( 2 );
use draft;

define behavior for ZC_PO_HD_DT_D_D alias Header
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Items { create; with draft; }
}

define behavior for ZC_PO_IS_DT_D_D alias Item
{
  use update;
  use delete;

  use association _Header { with draft; }
}